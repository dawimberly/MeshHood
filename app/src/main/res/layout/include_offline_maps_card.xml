<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/offlineMapsCard"
    style="@style/Widget.MeshHood.MapCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_md"
    android:layout_marginBottom="@dimen/spacing_xs"
    android:visibility="gone"
    app:cardBackgroundColor="@color/mesh_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_sm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/offlineMapsCardTitle"
                style="@style/MeshHoodTextTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/offline_maps_card_title"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/offlineMapsCardDismiss"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/offline_maps_card_dismiss_cd"
                android:src="@drawable/ic_close"
                app:tint="@color/mesh_on_surface_variant" />
        </LinearLayout>

        <TextView
            android:id="@+id/offlineMapsCardBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/offline_maps_card_body"
            android:textColor="@color/mesh_on_surface_variant"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/offlineMapsCardAction"
            style="@style/Widget.MeshHood.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/offline_maps_card_action" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
