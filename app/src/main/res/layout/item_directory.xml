<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_min"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/spacing_md"
    android:paddingVertical="@dimen/spacing_sm">

    <FrameLayout
        android:id="@+id/directoryAvatarButton"
        android:layout_width="@dimen/profile_avatar"
        android:layout_height="@dimen/profile_avatar"
        android:background="@drawable/avatar_stroke"
        android:clickable="true"
        android:contentDescription="@string/peer_profile_cd"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="2dp">

        <ImageView
            android:id="@+id/directoryAvatarImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/avatar_circle"
            android:contentDescription="@string/profile_avatar_cd"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/directoryAvatarInitial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/avatar_circle"
            android:gravity="center"
            android:textColor="@color/mesh_teal_light"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/directoryVerifiedBadge"
            android:layout_width="@dimen/profile_avatar_badge"
            android:layout_height="@dimen/profile_avatar_badge"
            android:layout_gravity="bottom|end"
            android:contentDescription="@string/profile_photo_verified_cd"
            android:src="@drawable/ic_verified_badge"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/directoryNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/mesh_on_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/directorySubtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/mesh_on_surface_variant"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
