<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MeshHood" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/mesh_primary</item>
        <item name="colorPrimaryVariant">@color/mesh_primary_container</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/mesh_teal</item>
        <item name="colorSecondaryVariant">@color/mesh_teal</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@color/mesh_bg</item>
        <item name="android:statusBarColor">@color/mesh_bg</item>
        <item name="android:navigationBarColor">@color/mesh_surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Widget.MeshHood.Chip" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="strokeColor">@color/mesh_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/mesh_surface</item>
        <item name="android:textColor">@color/mesh_on_surface</item>
        <item name="cornerRadius">@dimen/corner_lg</item>
    </style>

    <style name="Widget.MeshHood.ChipSelected" parent="Widget.MeshHood.Chip">
        <item name="strokeColor">@color/mesh_primary</item>
        <item name="backgroundTint">@color/mesh_primary_container</item>
        <item name="android:textColor">@color/mesh_primary</item>
    </style>

    <style name="Widget.MeshHood.EmergencyButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/emergency_height</item>
        <item name="backgroundTint">@color/mesh_emergency</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/corner_md</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
        <item name="iconTint">@color/white</item>
    </style>

    <style name="Widget.MeshHood.SendButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/mesh_primary</item>
        <item name="cornerRadius">@dimen/corner_lg</item>
        <item name="iconTint">@color/white</item>
    </style>
</resources>
