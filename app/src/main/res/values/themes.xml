<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MeshHood" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/mesh_primary</item>
        <item name="colorPrimaryVariant">@color/mesh_primary_container</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/mesh_teal</item>
        <item name="colorSecondaryVariant">@color/mesh_teal</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:statusBarColor">@color/mesh_bg_top</item>
        <item name="android:navigationBarColor">@color/mesh_surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="MeshHoodTextTitle" parent="android:Widget.TextView">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/mesh_on_surface</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="MeshHoodTextSubtitle" parent="android:Widget.TextView">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/mesh_on_surface_variant</item>
    </style>

    <style name="MeshHoodTextSection" parent="android:Widget.TextView">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/mesh_teal</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Widget.MeshHood.Chip" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="strokeColor">@color/mesh_stroke_subtle</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/mesh_surface_elevated</item>
        <item name="android:textColor">@color/mesh_on_surface</item>
        <item name="cornerRadius">@dimen/corner_lg</item>
        <item name="rippleColor">@color/mesh_teal_glow</item>
    </style>

    <style name="Widget.MeshHood.ChipCompact" parent="Widget.MeshHood.Chip">
        <item name="android:textSize">12sp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="backgroundTint">@color/mesh_surface</item>
    </style>

    <style name="Widget.MeshHood.ChipSelected" parent="Widget.MeshHood.Chip">
        <item name="strokeColor">@color/mesh_teal</item>
        <item name="backgroundTint">@color/mesh_nav_selected</item>
        <item name="android:textColor">@color/mesh_teal_light</item>
    </style>

    <style name="Widget.MeshHood.EmergencyButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/emergency_glow_bg</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">24dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
        <item name="iconTint">@color/white</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="Widget.MeshHood.ChipAccent" parent="Widget.MeshHood.Chip">
        <item name="strokeColor">@color/mesh_teal</item>
        <item name="backgroundTint">@color/mesh_nav_selected</item>
        <item name="android:textColor">@color/mesh_teal_light</item>
        <item name="iconTint">@color/mesh_teal</item>
    </style>

    <style name="Widget.MeshHood.MapCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/mesh_card</item>
        <item name="cardCornerRadius">@dimen/corner_xl</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/mesh_card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.MeshHood.SendButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:background">@drawable/send_btn_circle</item>
        <item name="backgroundTint">@null</item>
        <item name="cornerRadius">22dp</item>
        <item name="iconTint">@color/white</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="Widget.MeshHood.EmergencyButtonCompact" parent="Widget.MeshHood.EmergencyButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">22dp</item>
        <item name="android:elevation">0dp</item>
    </style>
</resources>
